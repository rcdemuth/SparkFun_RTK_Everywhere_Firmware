{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal RTK Everywhere Board Specification",
  "version": "2.0.0",
  "description": "Board and GNSS hardware compilation profile generated by Universal RTK Firmware Studio",
  "supported_mcu_families": ["esp32", "esp32-s3", "esp32-c3", "esp32-c6", "rp2040"],
  "supported_gnss_chipsets": [
    "um981",
    "um980",
    "zed_f9p",
    "lg290p",
    "lc29h",
    "cm260r",
    "bynav_m21_m22",
    "commnav_k827_k922",
    "comnav_k802",
    "skytraq_px1122r",
    "skytraq_px1172r",
    "quectel_lg69t",
    "allystar_tau1308"
  ],
  "sample_configuration": {
    "board_id": "cyd-esp32-2432s028",
    "gnss_id": "um981",
    "role": "rover",
    "bluetooth": "classic_spp",
    "pins": {
      "gnss_tx": 27,
      "gnss_rx": 22,
      "gnss_reset": 35,
      "gnss_pps": 21,
      "i2c_sda": 27,
      "i2c_scl": 22,
      "sd_cs": 5,
      "status_led": 16
    },
    "tilt_engine": {
      "enabled": true,
      "onboard_imu": true,
      "pole_height_m": 1.80,
      "max_angle_deg": 35,
      "auto_rock_calibration": true
    }
  }
}
